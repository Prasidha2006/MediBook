# Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Neon Database Connection URL
# Replace with your Neon connection string: postgresql://[user]:[password]@[neon-hostname]/medibook?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medibook?schema=public"

# JWT Authentication Secrets
JWT_SECRET=medibook_super_secret_jwt_access_token_key_2026_xyz
JWT_REFRESH_SECRET=medibook_super_secret_refresh_token_key_2026_abc
JWT_EXPIRES_IN=7d

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:5173
